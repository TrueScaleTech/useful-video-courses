---
// Root page: sends visitors to their language. English is the default.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Useful video courses</title>
    <meta http-equiv="refresh" content={`0; url=${base}/en/`} />
    <link rel="canonical" href={`${base}/en/`} />
    <script is:inline define:vars={{ base }}>
      if ((navigator.language || '').toLowerCase().startsWith('it')) {
        location.replace(base + '/it/');
      }
    </script>
  </head>
  <body>
    <p>
      <a href={`${base}/en/`}>English</a> · <a href={`${base}/it/`}>Italiano</a>
    </p>
  </body>
</html>
