---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CourseCard from '../../components/CourseCard.astro';
import { LOCALES, STRINGS, type Locale } from '../../i18n';
import { KINDS } from '../../content.config';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = STRINGS[locale];

// Drafts stay hidden, unless SHOW_DRAFTS=1 is set to preview the layout.
const showDrafts = process.env.SHOW_DRAFTS === '1';
const courses = (await getCollection('courses', ({ data }) => showDrafts || !data.draft)).sort(
  (a, b) => b.data.added.getTime() - a.data.added.getTime(),
);

// "5 channels · 14 videos": each part is left out when it is zero, so a filtered list reads "5 channels".
function countLabel(channels: number, videos: number): string {
  const part = (n: number, one: string, many: string) =>
    n === 1 ? one : many.replace('{n}', String(n));
  const parts: string[] = [];
  if (channels > 0) parts.push(part(channels, t.channelOne, t.channelMany));
  if (videos > 0 || channels === 0) parts.push(part(videos, t.videoOne, t.videoMany));
  return parts.join(' · ');
}
const channelCount = courses.filter((c) => c.data.kind === 'channel').length;
const videoCount = courses.length - channelCount;
---

<Base locale={locale} page="courses">
  <section class="opening">
    <h1>{t.siteTitle}</h1>
    <p class="wall-text">{t.intro}</p>
  </section>

  {courses.length > 0 && (
    <form class="filters" id="filters" aria-label={t.navCourses} hidden>
      <label>
        {t.filterKind}
        <select name="kind">
          <option value="">{t.all}</option>
          {KINDS.map((kind) => (
            <option value={kind}>{t.kinds[kind]}</option>
          ))}
        </select>
      </label>
      <p class="count" id="count" aria-live="polite">
        {countLabel(channelCount, videoCount)}
      </p>
    </form>
  )}

  <ul class="wall" id="grid">
    {courses.map((course) => (
      <CourseCard course={course} locale={locale} />
    ))}
  </ul>
  <p class="empty" id="empty" hidden>
    {t.empty}
  </p>
  {courses.length === 0 && <p class="empty">{t.empty}</p>}

  <script
    is:inline
    define:vars={{
      channelOne: t.channelOne,
      channelMany: t.channelMany,
      videoOne: t.videoOne,
      videoMany: t.videoMany,
    }}
  >
    // Progressive enhancement: without JavaScript every course stays visible.
    (function () {
      var form = document.getElementById('filters');
      if (!form) return;
      // The filters only exist for readers whose browser runs this script.
      form.hidden = false;
      var cards = Array.prototype.slice.call(document.querySelectorAll('#grid .work'));
      var count = document.getElementById('count');
      var empty = document.getElementById('empty');
      function part(n, one, many) {
        return n === 1 ? one : many.replace('{n}', String(n));
      }
      // Same wording as the server-rendered text: a part that is zero is left out.
      function label(channels, videos) {
        var parts = [];
        if (channels > 0) parts.push(part(channels, channelOne, channelMany));
        if (videos > 0 || channels === 0) parts.push(part(videos, videoOne, videoMany));
        return parts.join(' · ');
      }

      function apply() {
        var kind = form.elements.kind.value;
        var channels = 0;
        var videos = 0;
        cards.forEach(function (card) {
          var ok = !kind || card.dataset.kind === kind;
          card.hidden = !ok;
          if (ok) {
            if (card.dataset.kind === 'channel') channels += 1;
            else videos += 1;
          }
        });
        count.textContent = label(channels, videos);
        empty.hidden = channels + videos !== 0;
      }

      form.addEventListener('change', apply);
      form.addEventListener('submit', function (e) {
        e.preventDefault();
      });
    })();
  </script>
</Base>
