---
import '@fontsource-variable/hanken-grotesk/wght.css';
import '../styles/global.css';
import { STRINGS, otherLocale, type Locale } from '../i18n';

// The switch always reads IT | EN, whichever language the page is in.
const SWITCH_ORDER: Locale[] = ['it', 'en'];

interface Props {
  locale: Locale;
  page: 'courses' | 'about';
  title?: string;
  description?: string;
}

const { locale, page, title, description } = Astro.props;
const t = STRINGS[locale];
const other = otherLocale(locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = page === 'about' ? 'about/' : '';
const pageTitle = title ? `${title} · ${t.siteTitle}` : t.siteTitle;
const pageDescription = description ?? t.tagline;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <!-- Only YouTube's image host may be contacted by the page; no frames, no other origins. -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'none'; img-src 'self' https://i.ytimg.com; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; base-uri 'none'; form-action 'none'"
    />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="alternate" hreflang={locale} href={`${base}/${locale}/${path}`} />
    <link rel="alternate" hreflang={other} href={`${base}/${other}/${path}`} />
    <!-- Apply a saved theme choice before the first paint, so the page never flashes the other theme. -->
    <script is:inline>
      try {
        var saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#content">
      {locale === 'it' ? 'Vai al contenuto' : 'Skip to content'}
    </a>
    <header class="site">
      <div class="wrap">
        <div class="tools">
          <!-- One link for the whole IT | EN mark: a click anywhere on it switches to the other language. -->
          <a
            class="lang"
            href={`${base}/${other}/${path}`}
            lang={other}
            hreflang={other}
            aria-label={t.switchLanguage}
          >
            {SWITCH_ORDER.map((code, i) => (
              <>
                {i > 0 && (
                  <span class="sep" aria-hidden="true">
                    |
                  </span>
                )}
                <span
                  class="code"
                  aria-hidden="true"
                  data-current={code === locale ? 'true' : undefined}
                >
                  {code.toUpperCase()}
                </span>
              </>
            ))}
          </a>
          <button
            type="button"
            class="theme"
            id="theme-toggle"
            hidden
            data-to-dark={t.toDarkTheme}
            data-to-light={t.toLightTheme}
          >
            <svg
              class="icon-moon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
            </svg>
            <svg
              class="icon-sun"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>
    <main id="content">
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site">
      <div class="wrap">
        <span>{t.footer}</span>
        <nav class="links" aria-label={locale === 'it' ? 'Collegamenti' : 'Links'}>
          {page === 'about' ? (
            <a href={`${base}/${locale}/`}>{t.navCourses}</a>
          ) : (
            <a href={`${base}/${locale}/about/`}>{t.navAbout}</a>
          )}
          <a href="https://github.com/TrueScaleTech/useful-video-courses" rel="noopener noreferrer">
            GitHub
          </a>
        </nav>
      </div>
    </footer>
    <script is:inline>
      // The toggle only exists for readers whose browser runs this script; without it the page follows the system theme.
      (function () {
        var button = document.getElementById('theme-toggle');
        if (!button) return;
        button.hidden = false;
        var root = document.documentElement;
        var system = window.matchMedia('(prefers-color-scheme: dark)');
        function current() {
          return root.dataset.theme || (system.matches ? 'dark' : 'light');
        }
        function sync() {
          var dark = current() === 'dark';
          button.dataset.state = dark ? 'dark' : 'light';
          button.setAttribute('aria-label', dark ? button.dataset.toLight : button.dataset.toDark);
        }
        button.addEventListener('click', function () {
          var next = current() === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try {
            localStorage.setItem('theme', next);
          } catch (e) {}
          sync();
        });
        system.addEventListener('change', sync);
        sync();
      })();
    </script>
  </body>
</html>
