---
import type { CollectionEntry } from 'astro:content';
import { STRINGS, type Locale } from '../i18n';
import { courseThumbnail } from '../lib/youtube';

interface Props {
  course: CollectionEntry<'courses'>;
  locale: Locale;
}

const { course, locale } = Astro.props;
const t = STRINGS[locale];
const d = course.data;
const isChannel = d.kind === 'channel';
// A playlist is a course made of several videos; a single video is opened as "the video".
const isPlaylist = URL.canParse(d.url) && new URL(d.url).pathname.startsWith('/playlist');
const openLabel = isChannel ? t.visitChannel : isPlaylist ? t.visit : t.visitVideo;
// Per-entry zoom for a banner whose artwork needs more (or less) than the default.
const bannerStyle =
  [
    d.coverZoom !== undefined && `--zoom:${d.coverZoom}`,
    d.coverFocusX !== undefined && `--focus-x:${d.coverFocusX}%`,
  ]
    .filter(Boolean)
    .join(';') || undefined;
// Only YouTube gives a stable thumbnail address; other platforms get a drawn plate.
const thumb =
  d.cover ?? (d.platform === 'youtube' ? courseThumbnail(d.url, d.thumbnailVideoId) : null);
// Only the year of the day an entry was added is shown.
const year = d.added.getFullYear();
const newTab = locale === 'it' ? 'si apre in una nuova scheda' : 'opens in a new tab';
---

<li class="work" data-kind={d.kind}>
  <!-- The cover is a second route to the same link; keyboard and screen-reader users get the caption link. -->
  <a
    class="cover-link"
    href={d.url}
    rel="noopener noreferrer"
    target="_blank"
    tabindex="-1"
    aria-hidden="true"
  >
    <div class="cover" data-topic={d.topics[0]}>
      {thumb ? (
        <img
          src={thumb}
          alt=""
          class={d.cover ? 'banner' : undefined}
          style={d.cover ? bannerStyle : undefined}
          width="480"
          height="360"
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer"
        />
      ) : (
        <span class="plate">{d.title}</span>
      )}
    </div>
  </a>
  <div class="label">
    <h2>{d.title}</h2>
    <p class="level">{t.levels[d.level]}</p>
    <p class="who">
      {d.author}, {t.platforms[d.platform]} · {t.kinds[d.kind]}
    </p>
    <p class="facts">
      {d.hours !== undefined && `${t.hours(d.hours)} · `}
      {d.free ? t.free : t.paid}
    </p>
    <p class="note">{d.note[locale]}</p>
    <a class="open" href={d.url} rel="noopener noreferrer" target="_blank">
      {openLabel}
      <svg
        viewBox="0 0 14 14"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        aria-hidden="true"
      >
        <path d="M4 10 10 4M5 4h5v5"></path>
      </svg>
      <span class="sr-only">({newTab})</span>
    </a>
    {!isChannel && <p class="small">{`${t.addedIn} ${year}`}</p>}
  </div>
</li>
